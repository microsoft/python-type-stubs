from functools import _Wrapped
from typing import Any, Callable, TypeVar
from typing_extensions import ParamSpec

_P = ParamSpec("_P")
_T = TypeVar("_T")
_Class = TypeVar("_Class", bound=type)

def call_highest_priority(method_name: str) -> Callable[[Callable[_P, _T]], Callable[_P, _T]]: ...
def sympify_method_args(cls: _Class) -> _Class: ...

# sympify_method_args replaces the temporary wrappers with signature-preserving methods.
def sympify_return(*args) -> Callable[[Callable[_P, _T]], Callable[_P, _T]]: ...
def _sympifyit(arg, retval=None) -> Callable[[Callable[_P, _T]], Callable[_P, _T]]: ...
def __sympifyit(func: Callable[_P, _T], arg, retval=None) -> Callable[_P, _T]: ...

class _SympifyWrapper:
    def __init__(self, func, args) -> None: ...
    def make_wrapped(self, cls) -> _Wrapped[..., Any, ..., Any]: ...
